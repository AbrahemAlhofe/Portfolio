---
import BaseLayout from '../layouts/BaseLayout.astro';
const studies = [
  {
    id: 'operations', tag: 'Povo Studios · Operations', title: 'Centralized production management',
    text: 'After identifying fragmented workflows and reporting delays, I designed and deployed a unified Coda production environment in three days. It connected more than five databases, supported 40+ employees, enabled role-based access, and made management visibility immediate.',
    stats: '92% output growth · $40/month · 81,051 rows', service: 'Internal operations system',
    images: [
      { src: '/case-studies/povo-centralized-production-management.png', alt: 'Povo Studios centralized production-management control panel' },
      { src: '/case-studies/povo-production-record-detail.png', alt: 'Povo Studios production record detail view' },
      { src: '/case-studies/povo-queue-versions.png', alt: 'Povo Studios queue versions management view' }
    ]
  },
  {
    id: 'ai-books', tag: 'Povo Studios · AI Operations', title: 'AI-powered book production',
    text: 'I established the department’s workflow, SOPs, training, AI writing instructions, production dashboard, and automated pipeline for converting generated material into formatted books.',
    stats: '50+ published books · 250–320 pages · ~$3 variable cost', service: 'AI production and automation'
  },
  {
    id: 'echo', tag: 'Echo · Custom QA', title: 'A platform shaped by production pressure',
    text: 'Echo replaces unreliable third-party annotation tooling with a purpose-built QA platform designed for Arabic text, unstable connectivity, modest devices, high annotation volume, structured data, and observability.',
    stats: '180k annotations/year · AWS + Next.js · PostgreSQL + Redis', service: 'Custom business platform'
  }
];
---

<BaseLayout title="Work — Ibrahim Elhofy" page="/work">
  <section class="mx-auto w-[min(calc(100%-2rem),1180px)] py-24">
    <p class="text-xs font-extrabold uppercase tracking-[.15em] text-[#92ffb8]">Selected work</p>
    <h1 class="mt-4 max-w-5xl text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl">Systems built around how work actually happens.</h1>
    <p class="mt-7 max-w-3xl text-lg text-[#98a3ad]">Operational insight, product thinking, and engineering applied to real constraints and measurable outcomes.</p>
  </section>
  <section class="border-t border-[#252c34] py-14">
    <div class="mx-auto w-[min(calc(100%-2rem),1180px)]">
      {studies.map((study) => <article class="grid gap-8 border-t border-[#252c34] py-11 first:border-t-0 lg:grid-cols-[.86fr_1.14fr]" id={study.id}>
        <div>
          <span class="text-xs font-extrabold uppercase tracking-[.13em] text-[#92ffb8]">{study.tag}</span>
          <h2 class="mt-2 text-3xl font-bold leading-none tracking-[-.05em]">{study.title}</h2>
          <p class="mt-4 text-[#98a3ad]">{study.text}</p>
          <p class="my-5 text-sm text-[#c5cdd3]">{study.stats}</p>
          <a class="inline-flex rounded-full bg-[#92ffb8] px-4 py-2 text-sm font-bold text-[#071009]" href={`/quote?service=${encodeURIComponent(study.service)}`}>Get a quote for a similar system</a>
        </div>
        {study.images ? <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">{study.images.map((image) => <figure class="overflow-hidden rounded-2xl border border-[#252c34] bg-[#101419] p-2 shadow-2xl shadow-black/25"><img class="aspect-video w-full rounded-xl object-cover object-top" src={image.src} alt={image.alt} loading="lazy" /><figcaption class="px-2 pb-1 pt-3 text-xs text-[#98a3ad]">{image.alt.replace('Povo Studios ', '')}</figcaption></figure>)}</div> : <div class="grid min-h-72 place-items-center rounded-2xl border border-[#252c34] bg-[#101419] text-xs tracking-[.13em] text-[#71808b]">APPROVED SYSTEM SCREENSHOT</div>}
      </article>)}
    </div>
  </section>
</BaseLayout>
