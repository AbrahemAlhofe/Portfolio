---
import BaseLayout from '../../layouts/BaseLayout.astro';
const studies=[['operations','إدارة الإنتاج المركزية','نظام تشغيل داخلي'],['ai-books','إنتاج الكتب بالذكاء الاصطناعي','الإنتاج والأتمتة بالذكاء الاصطناعي'],['echo','منصة Echo لضمان الجودة','منصة أعمال مخصصة']];
---
<BaseLayout title="الأعمال — إبراهيم الحوفي" lang="ar" page="/ar/work"><section class="mx-auto w-[min(calc(100%-2rem),1180px)] py-24"><p class="text-xs font-extrabold tracking-[.15em] text-[#92ffb8]">أعمال مختارة</p><h1 class="mt-4 max-w-5xl text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl">أنظمة مبنية حول طريقة حدوث العمل فعلياً.</h1></section><section class="border-t border-[#252c34] py-14"><div class="mx-auto w-[min(calc(100%-2rem),1180px)]">{studies.map(([id,title,service])=><article id={id} class="grid gap-8 border-t border-[#252c34] py-11 lg:grid-cols-2"><div><span class="text-xs font-extrabold tracking-[.13em] text-[#92ffb8]">دراسة حالة</span><h2 class="mt-2 text-3xl font-bold">{title}</h2><p class="mt-4 text-[#98a3ad]">حل عملي مبني على متطلبات الإنتاج الفعلية، يجمع الفهم التشغيلي والهندسة والتبني.</p><a class="mt-6 inline-flex rounded-full bg-[#92ffb8] px-4 py-2 text-sm font-bold text-[#071009]" href={`/ar/quote?service=${encodeURIComponent(service)}`}>اطلب عرضاً لنظام مشابه</a></div><div class="grid min-h-64 place-items-center rounded-2xl border border-[#252c34] bg-[#101419] text-xs text-[#71808b]">لقطة شاشة معتمدة للنظام</div></article>)}</div></section></BaseLayout>
