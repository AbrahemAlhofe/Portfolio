---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlider from '../../components/ImageSlider.astro';
const heroPhotos = [
  { src: '/hero-photos/keynote.jpeg', alt: 'إبراهيم الحوفي يتحدث في فعالية', position: 'right-0 top-0 z-30 w-[66%] rotate-3' },
  { src: '/hero-photos/team.jpeg', alt: 'إبراهيم الحوفي مع متعاونين', position: 'left-0 top-[15%] z-20 w-[62%] -rotate-3' },
  { src: '/hero-photos/meeting.jpeg', alt: 'إبراهيم الحوفي في اجتماع مهني', position: 'bottom-0 right-[14%] z-10 w-[64%] rotate-1' }
];
const studies = [
  {
    id: 'operations',
    title: 'إدارة الإنتاج المركزية',
    text: 'بيئة إنتاج موحدة تربط سير العمل والصلاحيات والتقارير وإدارة البيانات لفرق الإنتاج.',
    service: 'نظام تشغيل داخلي',
    images: [
      { src: '/case-studies/povo-centralized-production-management.png', alt: 'واجهة نظام إدارة الإنتاج', caption: 'لوحة التحكم المركزية لإدارة الإنتاج' },
      { src: '/case-studies/povo-production-record-detail.png', alt: 'تفاصيل سجل الإنتاج وسجل التدقيق', caption: 'تفاصيل سجل الإنتاج وسجل التدقيق' },
      { src: '/case-studies/povo-queue-versions.png', alt: 'إدارة إصدارات ومراحل الطابور', caption: 'إدارة إصدارات ومراحل الطابور' }
    ]
  },
  {
    id: 'ai-books',
    title: 'إنتاج الكتب بالذكاء الاصطناعي',
    text: 'عملية متكررة تجمع الكتابة المنظمة بالذكاء الاصطناعي وإدارة الإنتاج والأتمتة.',
    service: 'الإنتاج والأتمتة بالذكاء الاصطناعي',
    images: [
      { src: '/case-studies/povo-ai-textbooks-dashboard.png', alt: 'لوحة متابعة ومراجعة الإنتاج', caption: 'لوحة متابعة ومراجعة الإنتاج' },
      { src: '/case-studies/povo-ai-workflow-automation.png', alt: 'مسار أتمتة وتوليد الكتب', caption: 'مسار أتمتة وتوليد الكتب في n8n' }
    ]
  },
  {
    id: 'echo',
    title: 'أنظمة تدقيق ومراجعة PDF',
    text: 'منصات تدقيق وضمان جودة مخصصة لملفات PDF والنصوص العربية، تضمن عدم فقدان الملاحظات وتتحمل ما يزيد عن 180,000 تعليق تدقيق سنوياً.',
    service: 'نظام مراجعة وتدقيق PDF',
    images: [
      { src: '/case-studies/echo-pdf-proofing-workspace.png', alt: 'واجهة نظام تدقيق ومراجعة ملفات PDF', caption: 'فهرس المستند، تحديد النصوص، ولوحة الملاحظات المترابطة' },
      { src: '/case-studies/echo-pdf-comment-thread.png', alt: 'نافذة إضافة الملاحظات وتصنيفها', caption: 'محادثات الملاحظات وتصنيف الأخطاء (لغوية، فنية)' },
      { src: '/case-studies/echo-pdf-share-dialog.png', alt: 'مشاركة المستندات مع فرق العمل', caption: 'إدارة مشاركة المستندات وصلاحيات العرض عبر الأجهزة' }
    ]
  }
];
---
<BaseLayout title="إبراهيم الحوفي — مطور حلول الأعمال" lang="ar" page="/ar/"><section class="mx-auto grid w-[min(calc(100%-2rem),1180px)] items-center gap-14 py-24 lg:grid-cols-[1.2fr_.8fr]"><div><p class="text-xs font-extrabold uppercase tracking-[.15em] text-[#92ffb8]">مطور حلول الأعمال · القاهرة</p><h1 class="mt-4 max-w-5xl text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl">أبني أنظمة تجعل الأعمال <span class="text-[#98a3ad]">تتحرك.</span></h1><p class="mt-7 max-w-3xl text-lg text-[#98a3ad]">مهندس مبادر أقود نمو الأعمال من خلال الذكاء الاصطناعي والأتمتة والأنظمة الداخلية.</p><div class="mt-7 flex flex-wrap gap-3"><a class="rounded-full bg-[#92ffb8] px-5 py-3 font-bold text-[#071009]" href="/ar/#work">استكشف الأعمال</a><a class="rounded-full border border-[#252c34] px-5 py-3 font-bold" href="/ar/services">خدمات للشركات</a></div></div><div class="relative isolate z-0 mx-auto h-[390px] w-full max-w-[430px] sm:h-[460px]">{heroPhotos.map((photo,index)=><figure class:list={['absolute overflow-hidden rounded-2xl border border-white/15 bg-[#101419] p-2 shadow-2xl shadow-black/50',photo.position]}><img class="aspect-[4/5] w-full rounded-xl object-cover" src={photo.src} alt={photo.alt} loading={index===0?'eager':'lazy'} /></figure>)}</div></section><section id="work" class="border-y border-[#252c34] py-20"><div class="mx-auto w-[min(calc(100%-2rem),1180px)]"><div class="mb-10 grid gap-8 md:grid-cols-[.7fr_1.3fr]"><h2 class="text-4xl font-bold tracking-[-.055em] sm:text-6xl">العمل بالتفصيل.</h2><p class="text-lg text-[#98a3ad]">من تشخيص التعطّل التشغيلي حتى إطلاق أنظمة يعتمد عليها الفريق يومياً.</p></div>{studies.map(study=><article id={study.id} class="grid gap-8 border-t border-[#252c34] py-11 lg:grid-cols-[.86fr_1.14fr]"><div><span class="text-xs font-extrabold tracking-[.13em] text-[#92ffb8]">دراسة حالة</span><h3 class="mt-2 text-3xl font-bold">{study.title}</h3><p class="mt-4 text-[#98a3ad]">{study.text}</p><a class="mt-6 inline-flex rounded-full bg-[#92ffb8] px-4 py-2 text-sm font-bold text-[#071009]" href={`/ar/quote?service=${encodeURIComponent(study.service)}`}>اطلب عرضاً لنظام مشابه</a></div><div><ImageSlider images={study.images} lang="ar" /></div></article>)}</div></section><section class="border-t border-[#252c34] py-20"><div class="relative mx-auto w-[min(calc(100%-2rem),1180px)] overflow-hidden rounded-3xl border border-[#252c34] bg-gradient-to-r from-[#11171b] via-[#101419] to-[#0c120f] px-8 pt-10 sm:px-12 sm:pt-14 lg:px-14"><div class="pointer-events-none absolute -bottom-10 left-10 size-80 rounded-full bg-[#92ffb8]/10 blur-3xl"></div><div class="grid items-end gap-8 md:grid-cols-[1.3fr_.7fr]"><div class="relative z-10 pb-10 sm:pb-14"><h2 class="max-w-xl text-4xl font-bold leading-tight tracking-[-.055em] sm:text-5xl lg:text-[3.5rem]">هل تجاوزت عملياتك قدرة جداول البيانات؟</h2><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-[#92ffb8] px-5 py-3 font-bold text-[#071009] transition hover:bg-[#7be6a1]" href="/ar/quote">اطلب عرض سعر</a><a class="rounded-full border border-[#252c34] px-5 py-3 font-bold transition hover:border-[#98a3ad]" href="mailto:ibrahim.ali.elhofy@gmail.com?subject=Free%201-hour%20consultation">احجز استشارة مجانية</a></div></div><div class="relative z-10 flex justify-center md:justify-start"><img class="h-[300px] w-auto max-w-[260px] object-contain object-bottom grayscale contrast-110 sm:h-[360px] sm:max-w-[300px] lg:h-[400px]" src="/ibrahim-portrait.png" alt="إبراهيم الحوفي" loading="lazy" /></div></div></div></section></BaseLayout>
