---
import BaseLayout from '../../layouts/BaseLayout.astro';
const heroPhotos = [
  { src: '/hero-photos/keynote.jpeg', alt: 'إبراهيم الحوفي يتحدث في فعالية', position: 'right-0 top-0 z-30 w-[66%] rotate-3' },
  { src: '/hero-photos/team.jpeg', alt: 'إبراهيم الحوفي مع متعاونين', position: 'left-0 top-[15%] z-20 w-[62%] -rotate-3' },
  { src: '/hero-photos/meeting.jpeg', alt: 'إبراهيم الحوفي في اجتماع مهني', position: 'bottom-0 right-[14%] z-10 w-[64%] rotate-1' }
];
---
<BaseLayout title="إبراهيم الحوفي — مطور حلول الأعمال" lang="ar" page="/ar/"><section class="mx-auto grid w-[min(calc(100%-2rem),1180px)] items-center gap-14 py-24 lg:grid-cols-[1.2fr_.8fr]"><div><p class="text-xs font-extrabold uppercase tracking-[.15em] text-[#92ffb8]">مطور حلول الأعمال · القاهرة</p><h1 class="mt-4 max-w-5xl text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl">أبني أنظمة تجعل الأعمال <span class="text-[#98a3ad]">تتحرك.</span></h1><p class="mt-7 max-w-3xl text-lg text-[#98a3ad]">مهندس مبادر أقود نمو الأعمال من خلال الذكاء الاصطناعي والأتمتة والأنظمة الداخلية.</p><div class="mt-7 flex flex-wrap gap-3"><a class="rounded-full bg-[#92ffb8] px-5 py-3 font-bold text-[#071009]" href="/ar/work">استكشف الأعمال</a><a class="rounded-full border border-[#252c34] px-5 py-3 font-bold" href="/ar/services">خدمات للشركات</a></div></div><div class="relative mx-auto h-[390px] w-full max-w-[430px] sm:h-[460px]">{heroPhotos.map((photo, index) => <figure class:list={['absolute overflow-hidden rounded-2xl border border-white/15 bg-[#101419] p-2 shadow-2xl shadow-black/50 transition-transform duration-500 hover:z-40 hover:scale-105 hover:rotate-0', photo.position]}><img class="aspect-[4/5] w-full rounded-xl object-cover" src={photo.src} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} /><figcaption class="sr-only">{photo.alt}</figcaption></figure>)}</div></section><section class="border-y border-[#252c34] py-16"><div class="mx-auto grid w-[min(calc(100%-2rem),1180px)] gap-4 md:grid-cols-3">{[['92%','نمو مخرجات الإنتاج'],['40%','تحسن إنتاجية ضمان الجودة'],['3 أيام','لبناء النظام وإطلاقه']].map(([metric,label])=><div class="rounded-2xl border border-[#252c34] bg-[#101419] p-7"><b class="block text-4xl tracking-[-.06em]">{metric}</b><span class="text-sm text-[#98a3ad]">{label}</span></div>)}</div></section><section class="mx-auto w-[min(calc(100%-2rem),1180px)] py-20"><div class="rounded-3xl border border-[#252c34] bg-[#101419] p-10"><h2 class="text-4xl font-bold tracking-[-.055em]">هل تجاوزت عملياتك قدرة جداول البيانات؟</h2><a class="mt-6 inline-flex rounded-full bg-[#92ffb8] px-5 py-3 font-bold text-[#071009]" href="/ar/quote">اطلب عرض سعر</a></div></section></BaseLayout>
