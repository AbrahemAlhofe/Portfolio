---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=['نظام تشغيل داخلي','الإنتاج والأتمتة بالذكاء الاصطناعي','منصة أعمال مخصصة','إعادة تصميم ضمان الجودة','تحليل العمليات وإعادة تصميمها','التدريب وإدارة التغيير'];
---
<BaseLayout title="اطلب عرض سعر — إبراهيم الحوفي" lang="ar"><section class="mx-auto w-[min(calc(100%-2rem),860px)] py-24"><p class="text-xs font-extrabold tracking-[.15em] text-[#92ffb8]">طلب مشروع</p><h1 class="mt-4 text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl">لنبدأ بفهم العملية.</h1><form id="quote-form" class="mt-12 grid gap-4 md:grid-cols-2"><label class="flex flex-col gap-2 text-sm font-bold">الاسم<input class="rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal" name="name" required/></label><label class="flex flex-col gap-2 text-sm font-bold">البريد الإلكتروني<input class="rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal" name="email" type="email" required/></label><label class="flex flex-col gap-2 text-sm font-bold">الخدمة<select id="service" name="service" class="rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal">{services.map(s=><option value={s}>{s}</option>)}</select></label><label class="flex flex-col gap-2 text-sm font-bold">التحدي الحالي<textarea class="min-h-32 rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal" name="challenge" required></textarea></label><button class="rounded-full bg-[#92ffb8] px-5 py-3 font-bold text-[#071009] md:col-span-2" type="submit">جهّز طلب عرض السعر</button></form></section></BaseLayout>
<script>const form=document.querySelector('#quote-form');const service=new URLSearchParams(location.search).get('service');const select=document.querySelector('#service');if(service&&select)select.value=service;form?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);location.href=`mailto:ibrahim.ali.elhofy@gmail.com?subject=${encodeURIComponent(`طلب عرض سعر: ${d.get('service')}`)}&body=${encodeURIComponent([...d].map(([k,v])=>`${k}: ${v}`).join('\n'))}`})</script>
