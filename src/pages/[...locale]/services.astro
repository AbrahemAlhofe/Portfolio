---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, type Locale } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { locale: undefined }, props: { locale: 'en' as Locale } },
    { params: { locale: 'ar' }, props: { locale: 'ar' as Locale } },
  ];
}

const { locale } = Astro.props;
const { lang, t } = getTranslations(locale);
const services = t.servicesPage;
const rootHref = lang === 'ar' ? '/ar/' : '/';
---

<BaseLayout title={t.meta.servicesTitle} description={t.meta.servicesDescription} lang={lang} page="/services">
  <section class="mx-auto w-[min(calc(100%-2rem),1180px)] py-24">
    <p class="text-xs font-extrabold uppercase tracking-[.15em] text-[#92ffb8]">{services.badge}</p>
    <h1 class="mt-4 max-w-5xl text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl">{services.title}</h1>
    <p class="mt-7 max-w-3xl text-lg text-[#98a3ad]">{services.description}</p>
  </section>
  <section class="border-t border-[#252c34] py-20">
    <div class="mx-auto grid w-[min(calc(100%-2rem),1180px)] gap-4 md:grid-cols-2 lg:grid-cols-3">
      {services.items.map((item, index) => (
        <article class="flex min-h-72 flex-col rounded-2xl border border-[#252c34] bg-[#101419] p-7">
          <span class="text-xs font-extrabold uppercase tracking-[.13em] text-[#92ffb8]">0{index + 1} / {services.serviceLabel}</span>
          <h2 class="mt-7 text-2xl font-bold tracking-[-.035em]">{item.title}</h2>
          <p class="mt-3 text-[#98a3ad]">{item.text}</p>
          <div class="mt-auto flex flex-wrap gap-2 pt-6">
            <a class="rounded-full bg-[#92ffb8] px-4 py-2 text-sm font-bold text-[#071009]" href="https://tally.so/r/DqBz65" target="_blank" rel="noopener noreferrer">{services.quoteBtn}</a>
            <a class="rounded-full border border-[#252c34] px-4 py-2 text-sm font-bold" href={`${rootHref}#${item.caseId}`}>{services.relatedCase}</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
