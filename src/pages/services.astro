---
import BaseLayout from '../layouts/BaseLayout.astro';
const services = [
  ['Internal operations systems', 'Centralized production tracking, workflow coordination, permissions, dashboards, and reporting.', 'Internal operations system', 'operations'],
  ['AI production & automation', 'Structured AI workflows, repeatable content pipelines, and human-in-the-loop operations.', 'AI production and automation', 'ai-books'],
  ['PDF proofing & QA systems', 'Purpose-built document annotation, proofreading workflows, Arabic text handling, and zero-data-loss quality platforms.', 'PDF proofing system', 'echo'],
  ['Business-critical platforms', 'Purpose-built internal software for real reliability, language, scale, and workflow needs.', 'Custom business platform', 'echo'],
  ['QA workflow redesign', 'Error reporting, review flows, traceability, and a quality analytics foundation.', 'QA workflow redesign', 'echo'],
  ['Process analysis & redesign', 'Operational mapping, bottleneck discovery, requirements definition, and transformation roadmaps.', 'Process analysis and redesign', 'operations'],
  ['Training & change enablement', 'Practical rollout, training, documentation, and continuous optimization.', 'Training and change enablement', 'operations']
];
---
<BaseLayout title="Services — Ibrahim Elhofy" page="/services"><section class="mx-auto w-[min(calc(100%-2rem),1180px)] py-24"><p class="text-xs font-extrabold uppercase tracking-[.15em] text-[#92ffb8]">Services for growing operations</p><h1 class="mt-4 max-w-5xl text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl">Your workflow should be an advantage—not a daily workaround.</h1><p class="mt-7 max-w-3xl text-lg text-[#98a3ad]">I turn fragmented processes into reliable internal systems, from operational diagnosis through implementation and team adoption.</p></section><section class="border-t border-[#252c34] py-20"><div class="mx-auto grid w-[min(calc(100%-2rem),1180px)] gap-4 md:grid-cols-2 lg:grid-cols-3">{services.map(([title,text,service,caseId],index)=><article class="flex min-h-72 flex-col rounded-2xl border border-[#252c34] bg-[#101419] p-7"><span class="text-xs font-extrabold uppercase tracking-[.13em] text-[#92ffb8]">0{index+1} / Service</span><h2 class="mt-7 text-2xl font-bold tracking-[-.035em]">{title}</h2><p class="mt-3 text-[#98a3ad]">{text}</p><div class="mt-auto flex flex-wrap gap-2 pt-6"><a class="rounded-full bg-[#92ffb8] px-4 py-2 text-sm font-bold text-[#071009]" href="https://tally.so/r/DqBz65" target="_blank" rel="noopener noreferrer">Get a quote</a><a class="rounded-full border border-[#252c34] px-4 py-2 text-sm font-bold" href={`/#${caseId}`}>Related case</a></div></article>)}</div></section></BaseLayout>
