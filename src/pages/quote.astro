---
import BaseLayout from '../layouts/BaseLayout.astro';
const services=['Internal operations system','AI production and automation','PDF proofing system','Custom business platform','QA workflow redesign','Process analysis and redesign','Training and change enablement'];
---
<BaseLayout title="Get a Quote — Ibrahim Elhofy"><section class="mx-auto w-[min(calc(100%-2rem),1180px)] py-24"><p class="text-xs font-extrabold uppercase tracking-[.15em] text-[#92ffb8]">Project inquiry</p><h1 class="mt-4 text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl">Let’s understand the operation first.</h1><p class="mt-7 max-w-3xl text-lg text-[#98a3ad]">Share the current challenge and desired outcome. Submitting prepares a structured email—nothing is stored on this site.</p></section><section class="border-t border-[#252c34] py-20"><form id="quote-form" class="mx-auto grid w-[min(calc(100%-2rem),860px)] gap-4 md:grid-cols-2">{[['name','Name','text'],['email','Email','email'],['company','Company','text']].map(([id,label,type])=><label class="flex flex-col gap-2 text-sm font-bold" for={id}>{label}<input class="rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal outline-none focus:ring-2 focus:ring-[#92ffb8]" id={id} name={id} type={type} required={id !== 'company'}/></label>)}<label class="flex flex-col gap-2 text-sm font-bold">Service<select id="service" name="service" class="rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal">{services.map(service=><option value={service}>{service}</option>)}</select></label><label class="flex flex-col gap-2 text-sm font-bold">Timeline<select name="timeline" class="rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal"><option>As soon as possible</option><option>Within 1–2 months</option><option>Within 3–6 months</option><option>Exploring options</option></select></label><label class="flex flex-col gap-2 text-sm font-bold">Budget<select name="budget" class="rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal"><option>Not specified</option><option>Under $1,000</option><option>$1,000–$5,000</option><option>$5,000–$15,000</option><option>$15,000+</option></select></label><label class="flex flex-col gap-2 text-sm font-bold md:col-span-2">Current challenge and desired outcome<textarea name="challenge" required class="min-h-36 rounded-xl border border-[#252c34] bg-[#101419] p-3 font-normal outline-none focus:ring-2 focus:ring-[#92ffb8]"></textarea></label><div class="md:col-span-2"><button class="rounded-full bg-[#92ffb8] px-5 py-3 font-bold text-[#071009]" type="submit">Prepare quote request →</button></div></form></section></BaseLayout>
<script>const form=document.querySelector('#quote-form');const service=new URLSearchParams(window.location.search).get('service');const select=document.querySelector('#service');if(service&&select)select.value=service;form?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);const body=[...d].map(([k,v])=>`${k}:\n${v}`).join('\n\n');location.href=`mailto:ibrahim.ali.elhofy@gmail.com?subject=${encodeURIComponent(`Quote request: ${d.get('service')}`)}&body=${encodeURIComponent(body)}`})</script>
