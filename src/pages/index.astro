---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageSlider from '../components/ImageSlider.astro';
const heroPhotos = [
  { src: '/hero-photos/keynote.jpeg', alt: 'Ibrahim Elhofy speaking at an event', position: 'left-0 top-0 z-30 w-[66%] -rotate-3' },
  { src: '/hero-photos/team.jpeg', alt: 'Ibrahim Elhofy with collaborators', position: 'right-0 top-[15%] z-20 w-[62%] rotate-3' },
  { src: '/hero-photos/meeting.jpeg', alt: 'Ibrahim Elhofy at a professional meeting', position: 'bottom-0 left-[14%] z-10 w-[64%] -rotate-1' }
];
const systems = [
  {
    tag: 'Operations transformation',
    title: 'Centralized production management',
    text: 'Replaced fragmented spreadsheets with a unified environment for production tracking, workflow coordination, permissions, and reporting.',
    stats: '81,051 rows · 5+ databases · 40+ employees',
    service: 'Internal operations system',
    images: [
      { src: '/case-studies/povo-centralized-production-management.png', alt: 'Povo Studios centralized production-management control panel', caption: 'Centralized production-management control panel' },
      { src: '/case-studies/povo-production-record-detail.png', alt: 'Production record detail view & audit trail', caption: 'Production record detail view & audit trail' },
      { src: '/case-studies/povo-queue-versions.png', alt: 'Queue versioning & stage transitions', caption: 'Queue versioning & stage transitions' }
    ]
  },
  {
    tag: 'AI & automation',
    title: 'AI-powered book production',
    text: 'A repeatable operation combining structured AI writing, production tracking, automated PDF creation, and employee workflows.',
    stats: '50+ books · 250–320 pages · ~$3 per book',
    service: 'AI production and automation',
    images: [
      { src: '/case-studies/povo-ai-workflow-automation.png', alt: 'Automated textbook generation workflow pipeline in n8n', caption: 'Automated generation & export pipeline' },
      { src: '/case-studies/povo-ai-textbooks-dashboard.png', alt: 'Anova Textbooks production management dashboard', caption: 'Textbooks tracking & review dashboard' }
    ]
  },
  {
    tag: 'Platform & QA',
    title: 'Custom PDF proofing & QA systems',
    text: 'Purpose-built collaborative document review and annotation platforms designed to eliminate comment loss, handle complex Arabic typography, and streamline high-volume editorial QA.',
    stats: '180,000+ annotations/yr · 0% data loss · AWS + Next.js + PostgreSQL',
    service: 'PDF proofing system',
    images: [
      { src: '/case-studies/echo-pdf-proofing-workspace.png', alt: 'PDF proofing workspace with outlines and threaded review', caption: 'Document outlines, PDF text highlight, and threaded annotation panel' },
      { src: '/case-studies/echo-pdf-comment-thread.png', alt: 'In-document contextual comment thread with error classification', caption: 'In-document feedback threads with color-coded classification tags' },
      { src: '/case-studies/echo-pdf-share-dialog.png', alt: 'Document viewer link sharing and role-based access control', caption: 'Role-based viewer link sharing and document access control' }
    ]
  }
];
const experienceTimeline = [
  { id: 'operations', step: '01', title: 'Business process transformation & operational excellence', summary: 'Independently analyzed production operations, identified bottlenecks and fragmented workflows, and led process reengineering, digital adoption, and continuous optimization.', achievements: ['Increased monthly production output 92%, from 456 to 876 production hours.', 'Improved QA productivity 40% and reduced reporting turnaround from 3 days to minutes.', 'Led rollout, employee training, and iterative improvement for 40+ employees.', 'Delivered scalable, cost-efficient digital operations with role-based access and version history.'] },
  { id: 'ai-operations', step: '02', title: 'AI strategy, workflow automation & operations development', summary: 'Established a new AI-enabled production function from the ground up, defining operating procedures, training, performance tracking, and automated delivery workflows.', achievements: ['Produced and delivered 50+ AI-generated books published on Abjjad.', 'Created structured AI instructions for 250-320 page long-form content.', 'Integrated workflow automation and standardized PDF production.', 'Reached approximately $3 variable production cost per book.'] },
  { id: 'technical-leadership', step: '03', title: 'Technical leadership, product development & observability', summary: 'Led a technical team in translating operational feedback into reliable, scalable, and accessible product priorities for a high-volume production environment.', achievements: ['Established structured team workflows and pull-request reviews.', 'Integrated AWS, Redis, PostgreSQL, and Sentry-based observability.', 'Improved support for Arabic workflows, unstable connectivity, and modest hardware.', 'Supported a QA environment handling approximately 180,000 annotations annually.'] }
];
---

<BaseLayout title="Ibrahim Elhofy — Business Solutions Developer" page="/">
  <section class="grid min-h-[75vh] place-items-center py-20">
    <div class="mx-auto grid w-[min(calc(100%-2rem),1180px)] items-center gap-14 lg:grid-cols-[1.2fr_.8fr]">
      <div>
        <div class="mb-4 text-xs font-extrabold uppercase tracking-[.15em] text-[#92ffb8]">Business Solutions Developer · Cairo</div>
        <h1 class="max-w-5xl text-5xl font-bold leading-[.93] tracking-[-.065em] sm:text-7xl lg:text-[6.7rem]">I build systems that make businesses <span class="text-[#98a3ad]">move.</span></h1>
        <p class="mt-7 max-w-2xl text-lg text-[#98a3ad]">Self-driven engineer leading business growth through AI, automation, and internal systems—connecting operational reality with the right technology.</p>
        <div class="mt-7 flex flex-wrap gap-3"><a class="rounded-full bg-[#92ffb8] px-5 py-3 font-bold text-[#071009] transition hover:bg-[#7be6a1]" href="https://tally.so/r/DqBz65" target="_blank" rel="noopener noreferrer">Get a quote →</a></div>
      </div>
      <div class="relative isolate order-first z-0 mx-auto h-[390px] w-full max-w-[430px] lg:order-none sm:h-[460px]">
        {heroPhotos.map((photo, index) => <figure class:list={['absolute overflow-hidden rounded-2xl border border-white/15 bg-[#101419] p-2 shadow-2xl shadow-black/50 transition-transform duration-500 hover:z-40 hover:scale-105 hover:rotate-0', photo.position]}><img class="aspect-[4/5] w-full rounded-xl object-cover" src={photo.src} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} /></figure>)}
      </div>
    </div>
  </section>
  <section id="services" class="border-t border-[#252c34] py-20">
    <div class="mx-auto w-[min(calc(100%-2rem),1180px)]">
      <div class="mb-10 grid gap-8 md:grid-cols-[.7fr_1.3fr]">
        <h2 class="text-4xl font-bold leading-none tracking-[-.055em] sm:text-6xl">Services.</h2>
        <p class="text-lg text-[#98a3ad]">Operational systems and AI-enabled workflows shaped by real production environments.</p>
      </div>
      {systems.map((system) => (
        <article class="grid gap-8 border-t border-[#252c34] py-11 lg:grid-cols-[.86fr_1.14fr]">
          <div class="min-w-0">
            <span class="text-xs font-extrabold uppercase tracking-[.13em] text-[#92ffb8]">{system.tag}</span>
            <h3 class="mt-2 text-3xl font-bold leading-none tracking-[-.05em]">{system.title}</h3>
            <p class="mt-4 text-[#98a3ad]">{system.text}</p>
            <p class="my-5 text-sm text-[#c5cdd3]">{system.stats}</p>
            <a class="inline-flex rounded-full bg-[#92ffb8] px-4 py-2 text-sm font-bold text-[#071009]" href="https://tally.so/r/DqBz65" target="_blank" rel="noopener noreferrer">Get a quote for a similar system</a>
          </div>
          <div class="min-w-0 w-full max-w-full overflow-hidden">
            <ImageSlider images={system.images} lang="en" />
          </div>
        </article>
      ))}
    </div>
  </section>
  <section id="work" class="border-t border-[#252c34] py-20">
    <div class="mx-auto w-[min(calc(100%-2rem),1180px)]">
      <div class="mb-14 grid gap-8 md:grid-cols-[.7fr_1.3fr]">
        <h2 class="text-4xl font-bold leading-none tracking-[-.055em] sm:text-6xl">Professional experience.</h2>
        <p class="text-lg text-[#98a3ad]">A chronological record of self-initiated operational transformation, AI operations, and technical leadership—measured by business outcomes.</p>
      </div>

      <div class="border-t border-[#252c34] pt-12">
        <div class="mb-12 flex flex-col justify-between gap-4 border-b border-[#252c34] pb-8 md:flex-row md:items-end">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-[.15em] text-[#92ffb8]">Aug 2023 – Present</span>
            <h3 class="mt-2 text-3xl font-bold tracking-[-.04em] sm:text-4xl">Povo Studios</h3>
          </div>
          <p class="text-sm font-semibold text-[#98a3ad]">Business Solutions Developer · R&D Department</p>
        </div>

        <div class="relative before:absolute before:bottom-0 before:left-3.5 before:top-0 before:w-px before:bg-[#252c34]">
          {experienceTimeline.map((entry) => (
            <article id={entry.id} class="relative pb-14 pl-12 sm:pl-14 last:pb-0">
              <span class="absolute left-3.5 top-0 z-10 grid size-7 -translate-x-1/2 place-items-center rounded-full border border-[#92ffb8]/40 bg-[#090b0d] text-xs font-bold text-[#92ffb8]">{entry.step}</span>
              <div class="grid gap-6 md:grid-cols-[10rem_1fr] md:gap-8">
                <div>
                  <p class="text-sm font-bold text-white">Milestone {entry.step}</p>
                </div>
                <div>
                  <h4 class="text-3xl font-bold leading-none tracking-[-.05em]">{entry.title}</h4>
                  <p class="mt-4 max-w-3xl text-[#98a3ad]">{entry.summary}</p>
                  <ul class="mt-6 grid gap-3 text-sm text-[#c5cdd3] sm:grid-cols-2">
                    {entry.achievements.map((achievement) => <li class="border-l border-[#92ffb8]/50 pl-3">{achievement}</li>)}
                  </ul>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="border-t border-[#252c34] py-20">
    <div class="relative mx-auto w-[min(calc(100%-2rem),1180px)] overflow-hidden rounded-3xl border border-[#252c34] bg-gradient-to-r from-[#11171b] via-[#101419] to-[#0c120f] px-8 sm:px-12 lg:px-14">
      <div class="pointer-events-none absolute -bottom-10 right-10 size-80 rounded-full bg-[#92ffb8]/10 blur-3xl"></div>
      <div class="grid items-center gap-8 md:grid-cols-[1.3fr_.7fr]">
        <div class="relative z-10 pb-10 sm:pb-14">
          <h2 class="max-w-xl text-4xl font-bold leading-none tracking-[-.055em] sm:text-5xl lg:text-[3.5rem]">Have an operation that has outgrown spreadsheets?</h2>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="rounded-full bg-[#92ffb8] px-5 py-3 font-bold text-[#071009] transition hover:bg-[#7be6a1]" href="https://calendly.com/alhofeabrahem88/1hour" target="_blank" rel="noopener noreferrer">Book a free 1-hour consultation</a>
            <a class="rounded-full border border-[#252c34] px-5 py-3 font-bold transition hover:border-[#98a3ad]" href="https://tally.so/r/DqBz65" target="_blank" rel="noopener noreferrer">Get a quote</a>
          </div>
        </div>
        <div class="relative z-10 flex justify-center md:justify-end">
          <img
            class="h-[300px] w-auto max-w-[260px] object-contain object-bottom grayscale contrast-110 sm:h-[360px] sm:max-w-[300px] lg:h-[400px]"
            src="/ibrahim-portrait.png"
            alt="Ibrahim Elhofy"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
